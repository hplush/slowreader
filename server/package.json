{
  "name": "@slowreader/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./test": "./test.ts"
  },
  "scripts": {
    "test": "FORCE_COLOR=1 pnpm run /^test:/",
    "start": "node --watch index.ts --port 2554",
    "migration": "drizzle-kit generate && oxfmt ./db/**/*.json",
    "database": "drizzle-kit studio --host 0.0.0.0 --port 2557",
    "build": "node --run clean:build && pnpm run /^build:/",
    "production": "node --run build && ./scripts/run-image.sh",
    "build:server": "pnpm -F server --prod deploy dist && ./scripts/vendor-workspace.sh",
    "build:assets": "mkdir -p web/ && cp -fr ../web/dist web/ && cp ../web/routes.regexp ../web/nginx.conf web/",
    "test:offline:coverage": "bnt --coverage 100 --coverage-exclude '{lib/exit.ts,db/index.ts,../api/**,../proxy/**,test.ts}'",
    "clean:build": "rm -rf dist/ web/"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@logux/actions": "0.7.2",
    "@logux/core": "0.11.6",
    "@logux/server": "0.16.0",
    "@slowreader/api": "workspace:*",
    "@slowreader/proxy": "workspace:*",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "drizzle-orm": "1.0.0-rc.4",
    "just-debounce-it": "3.2.0",
    "nanoid": "6.0.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@logux/client": "0.25.0",
    "better-node-test": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
