{
  "name": "@slowreader/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./test": "./test.ts"
  },
  "scripts": {
    "test": "FORCE_COLOR=1 pnpm run /^test:/",
    "start": "node --watch index.ts --port 2554",
    "migration": "drizzle-kit generate && oxfmt ./db/**/*.json",
    "database": "drizzle-kit studio --host 0.0.0.0 --port 2557",
    "aaguids": "rm -f aaguids/names.json && node aaguids/download.ts",
    "build": "node --run clean:build && pnpm run /^build:/",
    "production": "node --run build && ./scripts/run-image.sh",
    "build:server": "pnpm -F server --prod deploy dist && ./scripts/vendor-workspace.sh && node aaguids/download.ts dist/aaguids/",
    "build:assets": "mkdir -p web/ && cp -fr ../web/dist web/ && cp ../web/routes.regexp ../web/nginx.conf web/ && mkdir -p web/dist/docs/landings/ && mv web/dist/index.html web/dist/docs/landings/",
    "test:offline:coverage": "bnt --coverage 100 --coverage-exclude '{lib/exit.ts,db/index.ts,aaguids/utils.ts,../api/**,../proxy/**,test.ts,test/**}'",
    "clean:build": "rm -rf dist/ web/"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@logux/actions": "github:logux/actions#next",
    "@logux/core": "github:logux/core#next",
    "@logux/server": "github:logux/server#next",
    "@simplewebauthn/server": "14.0.3",
    "@slowreader/api": "workspace:*",
    "@slowreader/proxy": "workspace:*",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "drizzle-orm": "1.0.0-rc.4",
    "nanoid": "6.0.1",
    "postgres": "3.4.9",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@logux/client": "github:logux/client#next",
    "better-node-test": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
