{
  "name": "slowreader",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "FORCE_COLOR=1 pnpm run --parallel -F '*' '/^(test|own):/'",
    "quick": "nano-staged --unstaged --quiet --bail",
    "offline": "FORCE_COLOR=1 pnpm run --parallel -F '*' '/:offline:/'",
    "start": "FORCE_COLOR=1 pnpm run --parallel -F server -F web start",
    "format": "pnpm run --parallel -F '*' /^format:/",
    "clean": "pnpm run --parallel -F '*' /^clean:/",
    "build": "pnpm run -r build",
    "unused-messages": "node scripts/check-unused-messages.ts",
    "update-browsers": "node web/scripts/update-browsers.ts",
    "update-env": "node ./scripts/update-env.ts",
    "update-docker": "node ./scripts/update-docker.ts",
    "update-ci": "node --env-file-if-exists=.env node_modules/actions-up/bin/actions-up.js --min-age 1",
    "update-review": "node --env-file-if-exists=.env node_modules/multiocular/server/bin.js --port 2556",
    "format:oxfmt": "oxfmt .",
    "test:online:audit": "pnpm audit --prod",
    "own:online:markdown": "remark . --frail",
    "test:offline:js": "oxlint",
    "test:offline:messages": "node ./scripts/check-messages.ts",
    "test:offline:tests": "node ./scripts/check-tests.ts",
    "test:offline:versions": "node ./scripts/check-versions.ts",
    "clean:types": "rm -f */tsconfig.tsbuildinfo",
    "pnpm:devPreinstall": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@logux/eslint-config": "57.1.0",
    "@logux/oxc-configs": "1.2.0",
    "@playwright/mcp": "0.0.79",
    "@types/chrome": "0.2.8",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "actions-up": "1.18.0",
    "better-node-test": "1.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "jiti": "2.7.0",
    "multiocular": "0.8.4",
    "nano-staged": "1.0.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss-html": "2.0.0",
    "remark-cli": "12.0.1",
    "remark-lint-check-toc": "1.0.0",
    "remark-lint-code-block-split-list": "1.0.0",
    "remark-lint-fenced-code-flag": "4.2.0",
    "remark-lint-first-heading-level": "4.0.1",
    "remark-lint-heading-capitalization": "1.3.0",
    "remark-lint-heading-increment": "4.0.1",
    "remark-lint-match-punctuation": "0.2.1",
    "remark-lint-no-dead-urls": "2.0.1",
    "remark-lint-no-shell-dollars": "4.0.1",
    "remark-lint-smarty-pants-typography": "1.1.0",
    "remark-validate-links": "13.1.0",
    "stylelint": "17.14.1",
    "svelte": "5.57.0",
    "svelte-eslint-parser": "1.8.1",
    "svgo": "4.1.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.3.2"
}
