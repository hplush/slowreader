# {{ ansible_managed }}
# Proxy loads any URL from users, so it must not reach our local services,
# private networks, or Hetzner metadata.

table inet proxy_firewall
delete table inet proxy_firewall

table inet proxy_firewall {
  chain output {
    type filter hook output priority filter; policy accept;
    # Kernel packets like IPv6 neighbor discovery have no socket, so they
    # match neither `skuid ==` nor `skuid !=`. Only a positive match
    # lets them pass by the policy.
    meta skuid "slowreader-proxy" jump proxy
  }

  chain proxy {
    # Answers to Caddy and VictoriaMetrics
    ct state established,related accept
    # deploy-service checks health of proxy’s own ports
    ip daddr 127.0.0.1 tcp dport { {{ services['slowreader-proxy'].ports.values() | join(', ') }} } accept
    # pasta sends container’s DNS to systemd-resolved
    ip daddr 127.0.0.53 meta l4proto { tcp, udp } th dport 53 accept
    ip daddr {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
      172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15,
      224.0.0.0/3
    } reject
    ip6 daddr {
      ::/127, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7, fe80::/10, ff00::/8
    } reject
  }
}
