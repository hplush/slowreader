# {{ ansible_managed }}
# Keys and passphrase are in conf.d/secrets.conf
[global]
repo1-type=s3
repo1-s3-endpoint=s3.fr-par.scw.cloud
repo1-s3-region=fr-par
repo1-s3-bucket={{ backup_bucket }}
repo1-path=/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-retention-full=2
repo1-bundle=y
compress-type=zst
start-fast=y
log-level-console=info
log-level-file=off

[slowreader]
pg1-path=/var/lib/postgresql/{{ postgresql_version }}/main
pg1-socket-path=/run/postgresql
