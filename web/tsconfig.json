{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "lib": ["ES2024", "DOM", "DOM.AsyncIterable", "DOM.Iterable"],
    "types": ["trusted-types"]
  },
  "include": [
    "../scripts/progress.ts",
    "**/*.ts",
    "**/*.cts",
    "**/*.svelte",
    ".storybook/*.ts"
  ],
  "exclude": ["dist", "storybook-static"]
}
