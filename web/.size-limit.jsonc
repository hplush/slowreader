[
  {
    "name": "Files to download",
    "path": [
      "dist/**/*",
      "!dist/ui",
      "!dist/index.html",
      "!dist/landing/**",
      "!dist/robots.txt",
      "!dist/{404,500}.html",
      "!dist/copy-demo-db/**",
      "!dist/assets/copy-demo-db-*.{js,css}",
      "!dist/assets/opfs-worker-*.js",
      "!dist/demo.{json,sqlite}",
      "!dist/icon-*.{png,svg}",
      "!dist/apple-touch-icon.png",
      "!dist/og.jpg",
      "!dist/og/**",
      "!dist/releases/**",
      "!dist/docs/branding/**",
      "!dist/releases.atom",
      "!dist/favicon.ico",
      "!dist/assets/benchmark-*.js",
      "!dist/assets/devtools-*.js",
      "!dist/assets/*.woff",
      "!dist/assets/*.map",
      "!dist/sw.js.map",
      "!dist/assets/noto-*-{cyrillic,greek,devanagari,vietnamese}-*.woff2",
      "!dist/assets/noto-sans-mono-*.woff2",
      "!dist/assets/playpen-sans-*.woff2",
      "!dist/assets/{literata,merriweather,bitter,inter,atkinson-hyperlegible-next,lexend,opendyslexic}-*.woff2",
      "!dist/assets/*-{italic,math,latin-ext}-*.woff2"
    ],
    "limit": "735 KB"
  },
  {
    "name": "Landing page on phone",
    "path": [
      "dist/index.html",
      "dist/icon.svg",
      "dist/landing/**/*",
      "!dist/landing/small/**",
      "!dist/landing/og/**",
      "!dist/landing/!(slow-phone-824-*|slow-laptop-1244-*).avif",
      "!dist/landing/*.css",
      "!dist/landing/*.woff",
      "!dist/landing/noto-*-{cyrillic,greek,devanagari,vietnamese}-*.woff2",
      "!dist/landing/*-latin-ext-*.woff2"
    ],
    // Keep it a little bigger since screenshots may from demo DB
    "limit": "220 KB"
  },
  {
    "name": "Core scripts to execute",
    "path": ["dist/assets/app-*.js", "dist/assets/core-*.js"],
    "brotli": false,
    "limit": "580 KB"
  }
]
// Bump limits by 5 KB steps
