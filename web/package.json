{
  "name": "@slowreader/web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run /^test:/",
    "build": "pnpm run /^build:/ && mv ./storybook-static ./dist/ui",
    "start": "vite --host 0.0.0.0 --port 2553",
    "benchmark": "node ./scripts/benchmark.ts",
    "visual": "storybook dev -p 2555 --no-open --host 0.0.0.0",
    "chromatic": "node --env-file-if-exists=../.env node_modules/chromatic/dist/bin.cjs --exit-zero-on-changes --skip-update-check --exit-once-uploaded --only-changed --externals '**/pnpm-lock.yaml' --externals 'web/public/**'",
    "production": "node --run build && ./scripts/run-image.sh",
    "size": "node --run build:web && size-limit",
    "test:offline:names": "node ./scripts/check-names.ts",
    "test:offline:css": "stylelint .",
    "test:offline:svelte-types": "svelte-check --tsgo --output human --color",
    "test:offline:build": "node --run build && size-limit && node ./scripts/check-css-props.ts",
    "build:routes": "node ./scripts/export-routes.ts",
    "build:visual": "NODE_ENV=test storybook build --loglevel error",
    "build:web": "vite build && node scripts/generate-csp.ts",
    "format:css": "stylelint --fix .",
    "clean:build": "rm -rf dist .svelte-check routes.regexp",
    "build-storybook": "pnpm run build:visual"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@fontsource/inika": "5.3.0",
    "@fontsource/playpen-sans": "5.3.0",
    "@logux/client": "0.25.0",
    "@logux/core": "0.11.6",
    "@mdi/js": "7.4.47",
    "@nanostores/i18n": "1.3.3",
    "@nanostores/media-query": "0.1.2",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/router": "1.1.0",
    "@nanostores/sql": "0.5.2",
    "@slowreader/core": "workspace:*",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/svelte": "10.5.10",
    "@storybook/svelte-vite": "10.5.10",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "autoprefixer": "10.5.4",
    "keyux": "0.11.6",
    "lightningcss": "1.33.0",
    "nanostores": "1.5.2",
    "postcss": "8.5.26",
    "postcss-load-config": "6.0.1",
    "postcss-mixins": "12.1.2",
    "postcss-smooth-shadow": "0.3.2",
    "rollup": "4.63.0",
    "sqlocal": "0.18.0",
    "storybook": "10.5.10",
    "svelte": "5.56.10",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@logux/stylelint-config": "1.0.1",
    "@size-limit/file": "13.0.3",
    "@stylistic/stylelint-config": "5.0.0",
    "@stylistic/stylelint-plugin": "5.3.0",
    "@types/trusted-types": "2.0.7",
    "browserslist": "4.28.8",
    "chromatic": "18.6.0",
    "eslint": "10.9.1",
    "postcss-html": "2.0.0",
    "postcss-nesting": "14.0.1",
    "postcss-selector-parser": "7.1.5",
    "size-limit": "13.0.3",
    "stylelint": "17.14.1",
    "stylelint-use-logical": "2.1.3",
    "svelte-check": "4.7.6"
  }
}
